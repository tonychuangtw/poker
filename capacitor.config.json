{
  "appId": "com.tonychuang.pokertoolbox",
  "appName": "撲克工具箱",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0e0d"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#0b0e0d",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK"
    }
  }
}
